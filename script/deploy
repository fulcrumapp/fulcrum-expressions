#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
root_dir=${script_dir}/..

ENVIRONMENT="${USER:-}"
CONFIRM_PRODUCTION=false
ENVIRONMENT_SET=false

for argument in "$@"; do
  case "${argument}" in
    --yes)
      CONFIRM_PRODUCTION=true
      ;;
    --*)
      printf "Unknown option: %s\n" "${argument}" >&2
      exit 2
      ;;
    *)
      if [[ "${ENVIRONMENT_SET}" == true ]]; then
        printf "Only one deployment environment may be provided.\n" >&2
        exit 2
      fi
      ENVIRONMENT="${argument}"
      ENVIRONMENT_SET=true
      ;;
  esac
done

if [[ -z "${ENVIRONMENT}" && "${ENVIRONMENT_SET}" == false ]]; then
  ENVIRONMENT="$(id -un)"
fi
if [[ -z "${ENVIRONMENT}" ]]; then
  printf "Deployment environment must not be empty.\n" >&2
  exit 2
fi

if [[ "${ENVIRONMENT}" == "production" ]]
then
  printf "\nYOU ARE DEPLOYING TO PRODUCTION!!\n\n"
  if [[ "${CONFIRM_PRODUCTION}" == true ]]; then
    confirmation="y"
  else
    read -p "Are you sure you want to continue? (N/y): " confirmation
  fi
  if [[ "${confirmation}" != "y" && "${confirmation}" != "Y" ]]
  then
    printf "Deployment cancelled\n"
    exit 1
  fi
  bucket=fulcrum-assets
  deploy_prefix=expv1
  public_base_url="https://assets.fulcrumapp.com/${deploy_prefix}"
elif [[ "${ENVIRONMENT}" == "development" ]]
then
  bucket=fulcrum-assets
  deploy_prefix=dev-build
  public_base_url="https://assets.fulcrumapp.com/${deploy_prefix}"
else
  bucket=fulcrumapp-world-${ENVIRONMENT}
  deploy_prefix=expv1
  public_base_url="https://${bucket}.s3.amazonaws.com/${deploy_prefix}"
fi

configured_proxy="$(mktemp "${TMPDIR:-/tmp}/expression-proxy.XXXXXXXX")"
trap 'rm -f -- "$configured_proxy"' EXIT
node "${root_dir}/script/configure-sandbox-proxy.js" \
  "${root_dir}/dist/expressions-proxy.js" "$configured_proxy"

aws s3 cp \
  --cache-control "no-cache, no-store, max-age=0, must-revalidate" \
  --expires "Mon, 01 Jan 1990 00:00:00 GMT" \
  --content-type "application/javascript" \
  --acl "public-read" \
  "${root_dir}/dist/legacy/expressions.js" "s3://${bucket}/${deploy_prefix}/legacy/expressions.js"

printf "Deployed ${public_base_url}/legacy/expressions.js\n"

aws s3 cp \
  --cache-control "no-cache, no-store, max-age=0, must-revalidate" \
  --expires "Mon, 01 Jan 1990 00:00:00 GMT" \
  --content-type "application/javascript" \
  --acl "public-read" \
  "${root_dir}/dist/hybrid/expressions.js" "s3://${bucket}/${deploy_prefix}/hybrid/expressions.js"

printf "Deployed ${public_base_url}/hybrid/expressions.js\n"

aws s3 cp \
  --cache-control "no-cache, no-store, max-age=0, must-revalidate" \
  --expires "Mon, 01 Jan 1990 00:00:00 GMT" \
  --content-type "application/javascript" \
  --acl "public-read" \
  "$configured_proxy" "s3://${bucket}/${deploy_prefix}/expressions-proxy.js"

printf "Deployed ${public_base_url}/expressions-proxy.js\n"

for channel in legacy hybrid; do
  aws s3 cp \
    --cache-control "no-cache, no-store, max-age=0, must-revalidate" \
    --expires "Mon, 01 Jan 1990 00:00:00 GMT" \
    --content-type "text/html" \
    --acl "public-read" \
    "${root_dir}/dist/${channel}/expressions.html" "s3://${bucket}/${deploy_prefix}/${channel}/expressions.html"

  printf "Deployed ${public_base_url}/${channel}/expressions.html\n"
done

aws s3 cp \
  --cache-control "no-cache, no-store, max-age=0, must-revalidate" \
  --expires "Mon, 01 Jan 1990 00:00:00 GMT" \
  --content-type "text/html" \
  --acl "public-read" \
  "${root_dir}/dist/expressions.html" "s3://${bucket}/${deploy_prefix}/expressions.html"

printf "Deployed ${public_base_url}/expressions.html\n"

if [[ "${ENVIRONMENT}" == "production" || "${ENVIRONMENT}" == "development" ]]
then
    printf "Invalidating ${ENVIRONMENT} CloudFront path.\n"
    aws cloudfront create-invalidation \
      --distribution-id E1ONQRALSE0LBO \
      --paths "/${deploy_prefix}/*"

    printf "To get the status, run: aws cloudfront get-invalidation --distribution-id E1ONQRALSE0LBO --id #{id}\n"
    printf "Documentation says it can take up to 30 minutes to complete, but less than 5 is normal.\n"
fi
