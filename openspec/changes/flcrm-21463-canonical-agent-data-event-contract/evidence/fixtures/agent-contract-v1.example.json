{
  "schemaVersion": 1,
  "agentId": "record-agent",
  "agent": {
    "model": "gemma.task",
    "mode": "SIMPLE",
    "systemPrompt": "Answer using the supplied record.",
    "allowedTools": ["lookup_record"],
    "generation": {
      "maxTokens": 256,
      "temperature": 0.7,
      "stopSequences": []
    }
  },
  "task": {
    "inputs": {
      "query": "open records"
    },
    "references": [
      {
        "name": "model",
        "kind": "model-attachment",
        "required": true,
        "encoding": "binary",
        "maxBytes": "not-observed"
      },
      {
        "name": "labels",
        "kind": "labels-txt",
        "required": false,
        "encoding": "utf-8",
        "maxBytes": "not-observed"
      }
    ],
    "contract": {
      "strictOutputs": true,
      "inputs": [
        {
          "name": "query",
          "type": "string",
          "required": true
        }
      ],
      "outputs": [
        {
          "name": "answer",
          "type": "string",
          "required": true
        }
      ]
    }
  },
  "compatibility": {
    "nativeAliases": {
      "modelName": "native-only-compatibility-alias"
    },
    "expressionAliases": []
  }
}
